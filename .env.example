# ---- Clerk (drop your keys here, then copy to .env.local) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Agent ----
# Optional: OpenAI-compatible LLM. Without it the deterministic grounded engine is used.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---- Async extraction / OCR (optional) ----
# Documents whose first extraction pass finds no text (scanned PDFs, photos)
# are retried by the async worker. Leave the key blank and such documents end
# up `failed` instead of waiting forever; set it and they are OCR'd.
# OCR_API_URL defaults to https://api.openai.com/v1/chat/completions when
# blank. Any endpoint that accepts { filename, mimeType, data } and answers
# { text } also works.
OCR_API_KEY=
OCR_API_URL=
OCR_MODEL=gpt-4o-mini
# Secret for POST /api/knowledge/ocr (X-Webhook-Secret). Falls back to
# LEAD_WEBHOOK_SECRET. If neither is set the route rejects instead of
# accepting a default value.
OCR_RUN_SECRET=

# ---- WhatsApp Cloud API (optional, for nurture follow-ups) ----
# Meta WhatsApp Business Cloud API. Without these the nurture engine only
# records what it would have sent (audit log) — nothing leaves the building.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Inbound messages: Meta signs webhook POSTs with the app secret; the
# verification GET echoes hub.challenge when hub.verify_token matches.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Body of the free-form template used for outreach outside the 24h window.
# Meta requires an approved template name + language.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# ---- Hot-lead alerts (Knock, optional) ----
# When set, every lead that first crosses to "hot" triggers the Knock
# `hot-lead-alert` workflow (email/in-app via the provider you connect in the
# Knock dashboard). Without it the alert is only recorded in the audit log.
KNOCK_API_KEY=
KNOCK_WORKFLOW_KEY=hot-lead-alert
# Comma-separated Knock recipient ids (defaults to the tenant id).
ALERT_RECIPIENT_IDS=

# ---- Product analytics (PostHog, optional) ----
# Leave both blank to disable analytics; the app runs identically either way.
# Copy the browser-safe public project value and its ingestion host from the
# PostHog project settings. Regional hosts: https://us.i.posthog.com (US),
# https://eu.i.posthog.com (EU), or a self-hosted ingestion domain.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# ---- Platform ----
# Shared secret for the lead-form webhook (X-Webhook-Secret header).
# REQUIRED for the webhook to accept traffic: if unset it answers 503.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEAD_WEBHOOK_SECRET=
# Scheduler secret for the cron endpoints (x-cron-secret header), used by
# .github/workflows/scheduled-jobs.yml and any external cron. Set the same
# value as the CRON_SECRET Sites secret / GitHub Actions secret.
CRON_SECRET=
